<Window x:Class="Interfata.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vinyl Vibes" Height="800" Width="950"
        MinHeight="650" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D1A"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentRed"     Color="#E94560"/>
        <SolidColorBrush x:Key="AccentRedDark" Color="#B8304A"/>
        <SolidColorBrush x:Key="BgDeep"        Color="#0D0D1A"/>
        <SolidColorBrush x:Key="BgCard"        Color="#161628"/>
        <SolidColorBrush x:Key="BgInput"       Color="#1E1E35"/>
        <SolidColorBrush x:Key="BgInputHover"  Color="#252545"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#F0F0FF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9090B0"/>
        <SolidColorBrush x:Key="ErrorColor"    Color="#FF6B6B"/>
        <SolidColorBrush x:Key="SuccessColor"  Color="#4ADE80"/>
        <SolidColorBrush x:Key="BorderSubtle"  Color="#2A2A45"/>

        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background"              Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"              Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Height"                  Value="36"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"              Value="{StaticResource AccentRed}"/>
            <Setter Property="SelectionBrush"          Value="{StaticResource AccentRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                <Setter Property="Background"  Value="{StaticResource BgInputHover}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#4A4A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="Foreground"  Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="Background"          Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"          Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="Height"              Value="36"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Padding"             Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,30,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <Path x:Name="Arrow"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{StaticResource TextSecondary}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#1E1E35" BorderBrush="{StaticResource AccentRed}"
                                        BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="Arrow"  Property="Stroke"      Value="{StaticResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A4A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2D50"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A1A28"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentRedDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"   Value="{StaticResource BgInput}"/>
                                <Setter TargetName="bd" Property="BorderBrush"  Value="#4A4A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Width"       Value="6"/>
        </Style>

        <Style TargetType="ListBox" x:Key="ModernListBox">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding"    Value="0"/>
                        <Setter Property="Margin"     Value="0,0,0,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="card"
                                            Background="#161628"
                                            BorderBrush="#2A2A45"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Background"  Value="#1E1E38"/>
                                            <Setter TargetName="card" Property="BorderBrush" Value="#3A3A60"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="card" Property="Background"  Value="#1F0F1E"/>
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="ModernCheckBox">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box"
                                    Width="18" Height="18"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    Margin="0,0,8,0">
                                <Path x:Name="check"
                                      Data="M 2 9 L 7 14 L 16 3"
                                      Stroke="{StaticResource AccentRed}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box"   Property="Background"   Value="#2A0A1A"/>
                                <Setter TargetName="box"   Property="BorderBrush"  Value="{StaticResource AccentRed}"/>
                                <Setter TargetName="check" Property="Visibility"   Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A0A18" Offset="0"/>
                    <GradientStop Color="#0D0D1A" Offset="0.5"/>
                    <GradientStop Color="#0A0A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,18,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + titlu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E94560" Offset="0"/>
                                <GradientStop Color="#8B1A3A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🎵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Vinyl Vibes"
                                   Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Colecția ta de discuri"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Height="1" Margin="20,0"
                            VerticalAlignment="Center" Opacity="0.15">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E94560" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="#1F0F1E" BorderBrush="#E94560"
                        BorderThickness="1" CornerRadius="20" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="♪ " Foreground="#E94560" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TbNrVinyluri" Text="0 vinyluri"
                                   Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Opacity="0.3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#E94560" Offset="0.3"/>
                    <GradientStop Color="#E94560" Offset="0.7"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="20,14,20,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2A0A18" Offset="0"/>
                                <GradientStop Color="#1A1A2E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋ " Foreground="{StaticResource AccentRed}"
                                       FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Adaugă un vinyl nou"
                                       Foreground="White" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                                Fill="{StaticResource BorderSubtle}" Opacity="0.8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="20,16,20,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label x:Name="LblArtist" Content="Artist"
                                           Style="{StaticResource FieldLabel}"
                                           Target="{Binding ElementName=TxtArtist}"/>
                                    <TextBox x:Name="TxtArtist" Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock x:Name="TbErrArtist" FontSize="10"
                                               Foreground="{StaticResource ErrorColor}"
                                               Margin="2,3,0,0" Visibility="Collapsed"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label x:Name="LblTitlu" Content="Titlu album"
                                           Style="{StaticResource FieldLabel}"
                                           Target="{Binding ElementName=TxtTitlu}"/>
                                    <TextBox x:Name="TxtTitlu" Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock x:Name="TbErrTitlu" FontSize="10"
                                               Foreground="{StaticResource ErrorColor}"
                                               Margin="2,3,0,0" Visibility="Collapsed"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label x:Name="LblAn" Content="An lansare"
                                           Style="{StaticResource FieldLabel}"
                                           Target="{Binding ElementName=TxtAn}"/>
                                    <TextBox x:Name="TxtAn" Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock x:Name="TbErrAn" FontSize="10"
                                               Foreground="{StaticResource ErrorColor}"
                                               Margin="2,3,0,0" Visibility="Collapsed"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label x:Name="LblPret" Content="Preț (RON)"
                                           Style="{StaticResource FieldLabel}"
                                           Target="{Binding ElementName=TxtPret}"/>
                                    <TextBox x:Name="TxtPret" Style="{StaticResource ModernTextBox}"/>
                                    <TextBlock x:Name="TbErrPret" FontSize="10"
                                               Foreground="{StaticResource ErrorColor}"
                                               Margin="2,3,0,0" Visibility="Collapsed"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <Label x:Name="LblGen" Content="Gen muzical"
                                       Style="{StaticResource FieldLabel}"
                                       Target="{Binding ElementName=CmbGen}"/>
                                <ComboBox x:Name="CmbGen" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="— Selectați —" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="🎸  Rock" Tag="1"/>
                                    <ComboBoxItem Content="🎷  Jazz" Tag="2"/>
                                    <ComboBoxItem Content="🎤  Pop" Tag="4"/>
                                    <ComboBoxItem Content="🎵  Blues" Tag="8"/>
                                    <ComboBoxItem Content="🎹  Electronic" Tag="16"/>
                                    <ComboBoxItem Content="🎧  Hip-Hop" Tag="32"/>
                                    <ComboBoxItem Content="🎻  Clasic" Tag="64"/>
                                    <ComboBoxItem Content="🎙  R&amp;B" Tag="128"/>
                                    <ComboBoxItem Content="🎶  Soul" Tag="256"/>
                                    <ComboBoxItem Content="🎵  Altele" Tag="512"/>
                                </ComboBox>
                                <TextBlock x:Name="TbErrGen" Text="Selectați un gen muzical!"
                                           FontSize="10" Foreground="{StaticResource ErrorColor}"
                                           Margin="2,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label x:Name="LblFormat" Content="Format"
                                           Style="{StaticResource FieldLabel}"
                                           Target="{Binding ElementName=CmbFormat}"/>
                                    <ComboBox x:Name="CmbFormat" Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="— Selectați —" Tag="0" IsSelected="True"/>
                                        <ComboBoxItem Content="LP"           Tag="1"/>
                                        <ComboBoxItem Content="EP"           Tag="2"/>
                                        <ComboBoxItem Content="Single"       Tag="4"/>
                                        <ComboBoxItem Content="Reissue"      Tag="8"/>
                                        <ComboBoxItem Content="Colored"      Tag="16"/>
                                        <ComboBoxItem Content="Picture Disc" Tag="32"/>
                                    </ComboBox>
                                    <TextBlock x:Name="TbErrFormat" Text="Selectați un format!"
                                               FontSize="10" Foreground="{StaticResource ErrorColor}"
                                               Margin="2,3,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label x:Name="LblConditie" Content="Condiție disc"
                                           Style="{StaticResource FieldLabel}"
                                           Target="{Binding ElementName=CmbConditie}"/>
                                    <ComboBox x:Name="CmbConditie" Style="{StaticResource ModernComboBox}" FontSize="11">
                                        <ComboBoxItem Content="— Selectați —"      Tag="0" IsSelected="True"/>
                                        <ComboBoxItem Content="1 · Poor"           Tag="1"/>
                                        <ComboBoxItem Content="2 · Fair"           Tag="2"/>
                                        <ComboBoxItem Content="3 · Good"           Tag="3"/>
                                        <ComboBoxItem Content="4 · Good+"          Tag="4"/>
                                        <ComboBoxItem Content="5 · Very Good"      Tag="5"/>
                                        <ComboBoxItem Content="6 · VG+"            Tag="6"/>
                                        <ComboBoxItem Content="7 · Near Mint"      Tag="7"/>
                                        <ComboBoxItem Content="8 · Mint"           Tag="8"/>
                                    </ComboBox>
                                    <TextBlock x:Name="TbErrConditie" Text="Selectați condiția!"
                                               FontSize="10" Foreground="{StaticResource ErrorColor}"
                                               Margin="2,3,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#12121F" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                <StackPanel>
                                    <CheckBox x:Name="ChkImprumutat"
                                              Content="Disc împrumutat"
                                              Style="{StaticResource ModernCheckBox}"
                                              Checked="ChkImprumutat_Changed"
                                              Unchecked="ChkImprumutat_Changed"/>
                                    <StackPanel x:Name="PanelNumeImprumutat" Visibility="Collapsed" Margin="0,10,0,0">
                                        <Label x:Name="LblNumeImprumutat" Content="Nume persoână"
                                               Style="{StaticResource FieldLabel}"
                                               Target="{Binding ElementName=TxtNumeImprumutat}"/>
                                        <TextBox x:Name="TxtNumeImprumutat" Style="{StaticResource ModernTextBox}"/>
                                        <TextBlock x:Name="TbErrNumeImprumutat"
                                                   Text="Introduceți numele persoanei!"
                                                   FontSize="10" Foreground="{StaticResource ErrorColor}"
                                                   Margin="2,3,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="20,12,20,16">
                        <TextBlock x:Name="TbMesajSucces"
                                   FontSize="12" Foreground="{StaticResource SuccessColor}"
                                   FontWeight="SemiBold" Margin="0,0,0,10"
                                   Visibility="Collapsed" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="＋  Adaugă Vinyl"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="OnAdauga"/>
                            <Button Grid.Column="2" Content="Reset"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OnReset"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Colecția mea"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Toate vinylurile salvate"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="lstVinyluri" Style="{StaticResource ModernListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="44" Height="44"
                                        CornerRadius="22" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2A0A18" Offset="0"/>
                                            <GradientStop Color="#1A1A2E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="💿" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayNume}"
                                               Foreground="White" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayDetalii}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Column="2" VerticalAlignment="Center"
                                        CornerRadius="12" Padding="10,4" Margin="10,0,0,0"
                                        x:Name="StareBadge">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0F2A1F"/>
                                            <Setter Property="BorderBrush" Value="#1A5A3A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DisplayStare[0]}" Value="📤">
                                                    <Setter Property="Background"  Value="#2A0A0A"/>
                                                    <Setter Property="BorderBrush" Value="#6A1A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayStare}"
                                               FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DisplayStare[0]}" Value="📤">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" x:Name="BdrListaGoala" Visibility="Collapsed"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🎵" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Nicio piesă în colecție"
                                   Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Adaugă primul tău vinyl folosind formularul din stânga"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="260"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>